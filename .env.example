# Copy to .env.local. Without the Supabase values the app runs on demo data kept in the browser.
# These three are public by design; never put a secret or service_role key in an EXPO_PUBLIC_ value.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Web push (optional). The public half of the key pair; without it notifications stay hidden.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=

# Secrets for the /api/push function. Set these on the host only, never in the app.
# VAPID_PRIVATE_KEY=
# PUSH_SECRET=
